<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lootable Lowlifes - Blade & Sorcery (1.0+) loot drop mod.

    The game assemblies (ThunderRoad.dll, UnityEngine.*.dll) ship only with the
    game and must NOT be committed to the repo. Provide them one of two ways:

    1. Point at your install (local dev):
         dotnet build src/BanditLootMod.csproj \
           -p:BSInstallDir="C:\Program Files (x86)\Steam\steamapps\common\Blade & Sorcery"
       (or set the BLADE_AND_SORCERY_DIR environment variable)

    2. Drop the DLLs into the git-ignored ./libs folder at the repo root.
       This is the fallback used when no install dir is set, and is how CI
       supplies the assemblies. Required files:
         ThunderRoad.dll, UnityEngine.dll,
         UnityEngine.CoreModule.dll, UnityEngine.PhysicsModule.dll
  -->

  <PropertyGroup>
    <!-- Blade & Sorcery ships against .NET Standard 2.1 (Unity Mono/IL2CPP). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>LootableLowlifes</AssemblyName>
    <RootNamespace>LootableLowlifes</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <!-- Game DLLs are provided by the install; do not copy or publish them. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      Demote the benign assembly-version-conflict warnings (System.Net.Http /
      System.IO.Compression). They come from the netstandard2.1 reference
      assemblies vs. the versions ThunderRoad bundles, and do not affect the
      DLL that Unity loads at runtime.
    -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Resolve the managed assembly directory. Priority:
      1. BSInstallDir property / BLADE_AND_SORCERY_DIR env var -> game's Managed dir
      2. otherwise fall back to the repo-root ./libs folder (used by CI)
  -->
  <PropertyGroup>
    <BSInstallDir Condition="'$(BSInstallDir)' == ''">$(BLADE_AND_SORCERY_DIR)</BSInstallDir>
    <BSManagedDir Condition="'$(BSInstallDir)' != ''">$(BSInstallDir)\BladeAndSorcery_Data\Managed</BSManagedDir>
    <BSManagedDir Condition="'$(BSInstallDir)' == ''">$(MSBuildThisFileDirectory)..\libs</BSManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LootDropModule.cs" />
    <Compile Include="LootTable.cs" />
    <Compile Include="Config\DropConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ThunderRoad">
      <HintPath>$(BSManagedDir)\ThunderRoad.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BSManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BSManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BSManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(BSManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
